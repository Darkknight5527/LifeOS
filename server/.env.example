# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeos?retryWrites=true&w=majority

# Long random string used to sign JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on (Render sets this automatically in production)
PORT=4000

# Comma-separated list of allowed origins for CORS (your web app's URL)
CLIENT_ORIGIN=http://localhost:5173

# Morning Paper: your Google Calendar "Secret address in iCal format".
# Keep it secret — set it in Render's Environment settings, never commit it.
CALENDAR_ICS_URL=

# AI skin check (Grooming → Skin → Scan). Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model reads the photos.
# GEMINI_MODEL=gemini-3.8-flash
# Optional: models tried when the main one is busy (comma-separated).
# GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash-lite

# Email for the Focus mode emergency exit code (sent to your account email).
# On Render's free plan use Resend (SMTP is blocked there): resend.com → API Keys.
# Without your own domain it only delivers to the email you signed up with —
# set MAIL_TO to that address if it differs from your LifeOS login.
RESEND_API_KEY=
# MAIL_TO=
# Or SMTP (hosts that allow it). Gmail: SMTP_USER = your Gmail address, SMTP_PASS = a 16-letter app password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
